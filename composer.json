{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "repositories": {
        "lang-detect": {
            "type": "package",
            "package": {
                "name": "nlp-tools/lang-detect",
                "version": "1.0",
                "source": {
                    "url": "https://github.com/angeloskath/php-sourceclassifier",
                    "type": "git",
                    "reference": "34cef70"
                }
            }
        }
    },
    "require": {
        "php": "^8.0",
        "anhskohbo/no-captcha": "^3.7",
        "emojione/emojione": "^4.5",
        "intervention/image": "*",
        "laravel/framework": "^12.28",
        "laravel/reverb": "^1.0",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "lasserafn/php-initial-avatar-generator": "^4.4",
        "lasserafn/php-initials": "^3.1",
        "nlp-tools/lang-detect": "^1.0",
        "nlp-tools/nlp-tools": "dev-develop",
        "predis/predis": "^1.1",
        "pusher/pusher-php-server": "^7.2",
        "rachidlaasri/laravel-installer": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "beyondcode/laravel-dump-server": "^2.1",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^12.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
